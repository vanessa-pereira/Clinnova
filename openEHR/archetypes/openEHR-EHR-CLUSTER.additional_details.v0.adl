definition
	CLUSTER[at0000] matches {    -- Additional details
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Detail
				value matches {
					DV_BOOLEAN matches {*}
					DV_CODED_TEXT matches {*}
					DV_COUNT matches {*}
					DV_DATE matches {*}
					DV_DATE_TIME matches {*}
					DV_DURATION matches {*}
					DV_IDENTIFIER matches {*}
					DV_INTERVAL<DV_COUNT> matches {*}
					DV_INTERVAL<DV_DATE> matches {*}
					DV_INTERVAL<DV_DATE_TIME> matches {*}
					DV_INTERVAL<DV_DURATION> matches {*}
					DV_INTERVAL<DV_QUANTITY> matches {*}
					DV_INTERVAL<DV_TIME> matches {*}
					DV_MULTIMEDIA matches {*}
					DV_ORDINAL matches {*}
					DV_PARSABLE matches {*}
					DV_PROPORTION matches {*}
					DV_QUANTITY matches {*}
					DV_TEXT matches {*}
					DV_TIME matches {*}
					DV_URI matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Code
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Detail timestamp
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Specimen series code
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Biological material type code
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Biological material sequence
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- Filler assigner identifier
				value matches {
					DV_IDENTIFIER matches {*}
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- Specimen Expiration Date/Time
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
		}
	}

